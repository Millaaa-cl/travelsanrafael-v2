# ============================================================
# travelsanrafael.cl · Apache (cPanel)
# ============================================================
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Forzar HTTPS y quitar "www", manteniendo el mismo dominio
#    (genérico: sirve igual en travelsanrafael.cl y en un subdominio de prueba)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Redirecciones 301 desde las URLs del WordPress anterior
RewriteRule ^itinerario/?$ /tour-laguna-san-rafael/#itinerario [R=301,L,NE]
RewriteRule ^(cart|carrito|checkout|finalizar-compra|shop|tienda|product/.*|producto/.*)/?$ /tour-laguna-san-rafael/#reservar [R=301,L,NE]
RewriteRule ^(my-account|mi-cuenta)/?.*$ / [R=301,L]
RewriteRule ^wp-(admin|login\.php).*$ / [R=301,L]
RewriteRule ^feed/?$ /blog/ [R=301,L]

# 3) Bloquear archivos ocultos (.git, .env…)
RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# Seguridad básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Caché del navegador: assets con hash por 1 año, HTML siempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# El hosting agrega por su cuenta "Cache-Control: max-age=604800" (7 días) también al HTML, y gana sobre ExpiresByType:
# sin esto, quien vuelve al sitio puede ver precios o textos viejos hasta una semana después de publicar.
# "no-cache" no impide guardar la página: obliga al navegador a preguntar si cambió (responde 304 si no).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
