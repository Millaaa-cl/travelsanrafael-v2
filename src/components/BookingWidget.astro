---
/**
 * Widget de reserva (v2, sin backend): calendario con los días de temporada de `tour.booking`, pasajeros y datos
 * del cliente. Al enviar, abre WhatsApp con la solicitud lista (fecha, pasajeros, total y datos); el operador
 * confirma los cupos y coordina el pago por chat. JS vanilla, sin frameworks ni llamadas al servidor.
 */
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
import Icon from './Icon.astro';
import { business, tour, formatCLP } from '../data/tour';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].booking;
const i18n = {
  ...t, locale: lang === 'es' ? 'es-CL' : 'en-US', lang,
  wa: business.whatsapp, priceAdult: tour.priceFromCLP, priceChild: tour.priceChildCLP, cfg: tour.booking,
};
---
<aside class="booking" id="reservar" aria-labelledby="h-booking" data-i18n={JSON.stringify(i18n)}>
  <div class="booking__head">
    <h2 id="h-booking">{t.h}</h2>
    <p class="booking__price" style="margin:0"><strong>{formatCLP(tour.priceFromCLP)}</strong><small>{lang === 'es' ? 'por adulto' : 'per adult'}</small></p>
    <p class="booking__child">{lang === 'es' ? `Niños hasta ${tour.childMaxAge} años` : `Children up to ${tour.childMaxAge}`} <strong>{formatCLP(tour.priceChildCLP)}</strong></p>
    <p class="booking__notice"><Icon name="info" />{t.noTransport}</p>
  </div>

  <h3><span class="n">01</span>{t.step1}</h3>
  <div class="cal">
    <div class="cal__head">
      <button type="button" class="cal__nav" data-prev aria-label={t.prev}>‹</button>
      <strong data-month aria-live="polite"></strong>
      <button type="button" class="cal__nav" data-next aria-label={t.next}>›</button>
    </div>
    <div class="cal__grid" data-grid role="grid"></div>
    <ul class="cal__legend" aria-hidden="true">
      <li><span class="cal__key cal__key--open">12</span>{t.legendOpen}</li>
      <li><span class="cal__key cal__key--off">13</span>{t.legendOff}</li>
    </ul>
    <p class="cal__msg" data-msg role="status">{t.loading}</p>
  </div>

  <form data-form novalidate>
    <h3><span class="n">02</span>{t.step2}</h3>
    <div class="pax">
      <span>{t.adults}</span>
      <div class="pax__ctrl">
        <button type="button" data-dec="adults" aria-label="−">−</button>
        <output data-out="adults">1</output>
        <button type="button" data-inc="adults" aria-label="+">+</button>
      </div>
    </div>
    <div class="pax">
      <span>{t.children}</span>
      <div class="pax__ctrl">
        <button type="button" data-dec="children" aria-label="−">−</button>
        <output data-out="children">0</output>
        <button type="button" data-inc="children" aria-label="+">+</button>
      </div>
    </div>

    <h3><span class="n">03</span>{t.step3}</h3>
    <div class="field"><label for="bk-name">{t.name}</label><input id="bk-name" name="name" required autocomplete="name" maxlength="120" /></div>
    <div class="field field--row">
      <div><label for="bk-phone">{t.phone}</label><input id="bk-phone" name="phone" type="tel" required autocomplete="tel" maxlength="30" /></div>
      <div><label for="bk-country">{t.country}</label><input id="bk-country" name="country" autocomplete="country-name" maxlength="60" /></div>
    </div>
    <div class="field"><label for="bk-email">{t.email}</label><input id="bk-email" name="email" type="email" autocomplete="email" maxlength="160" /></div>
    <div class="field"><label for="bk-lodging">{t.lodging}</label><input id="bk-lodging" name="lodging" maxlength="160" /></div>
    <div class="field"><label for="bk-notes">{t.notes}</label><textarea id="bk-notes" name="notes" rows="2" maxlength="500"></textarea></div>
    <label class="check"><input type="checkbox" name="transport" /> <span>{t.transport}</span></label>
    <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="check"><input type="checkbox" name="terms" required /> <span>{t.terms} <a href={routes.terms[lang]} target="_blank">{t.termsLink}</a></span></label>

    <div class="summary" data-summary hidden></div>
    <button class="btn btn--primary btn--block" type="submit" data-submit disabled><Icon name="whatsapp" /><span data-label>{t.selectDate}</span></button>
    <p class="booking__sent" data-sent role="status" hidden></p>
    <p class="booking__note"><Icon name="whatsapp" />{t.secure}</p>
    <p class="booking__note">{t.hold}</p>
  </form>
</aside>

<script>
  type Dep = { date: string };
  const root = document.getElementById('reservar');
  if (root) {
    const T = JSON.parse(root.dataset.i18n || '{}');
    const cfg = T.cfg as { minDaysAhead: number; monthsAhead: number; seasonMonths: number[]; weekdays: number[]; closed: string[] };
    const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector(s) as unknown as E;
    const grid = $('[data-grid]'), msg = $('[data-msg]'), monthEl = $('[data-month]');
    const prevBtn = $<HTMLButtonElement>('[data-prev]'), nextBtn = $<HTMLButtonElement>('[data-next]');
    const form = $<HTMLFormElement>('[data-form]'), submit = $<HTMLButtonElement>('[data-submit]');
    const label = $('[data-label]'), summary = $('[data-summary]'), sentBox = $('[data-sent]');
    const money = new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 });
    const pax = { adults: 1, children: 0 };
    const MAX_PAX = 20;
    let selected: Dep | null = null;

    const pad = (n: number) => String(n).padStart(2, '0');
    const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const addMonth = (m: string, n: number) => {
      const [y, mo] = m.split('-').map(Number);
      const d = new Date(y, mo - 1 + n, 1);
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
    };
    const today = new Date();
    const first = new Date(today.getFullYear(), today.getMonth(), today.getDate() + cfg.minDaysAhead);
    const minMonth = `${today.getFullYear()}-${pad(today.getMonth() + 1)}`;
    const maxMonth = addMonth(minMonth, cfg.monthsAhead - 1);
    const closed = new Set(cfg.closed);
    const isOpen = (d: Date) =>
      d >= first && cfg.seasonMonths.includes(d.getMonth() + 1) && cfg.weekdays.includes(d.getDay()) && !closed.has(iso(d));
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const longDate = (s: string) => cap(new Date(s + 'T12:00:00').toLocaleDateString(T.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }));

    // Empieza en el primer mes con salidas (si el mes actual no tiene, p. ej. fuera de temporada)
    let month = minMonth;
    for (let i = 0; i < cfg.monthsAhead; i++) {
      const m = addMonth(minMonth, i);
      const [y, mo] = m.split('-').map(Number);
      const days = new Date(y, mo, 0).getDate();
      let found = false;
      for (let d = 1; d <= days && !found; d++) found = isOpen(new Date(y, mo - 1, d));
      if (found) { month = m; break; }
    }

    function render() {
      const [y, mo] = month.split('-').map(Number);
      monthEl.textContent = cap(new Date(y, mo - 1, 1).toLocaleDateString(T.locale, { month: 'long', year: 'numeric' }));
      prevBtn.disabled = month <= minMonth;
      nextBtn.disabled = month >= maxMonth;
      const offset = (new Date(y, mo - 1, 1).getDay() + 6) % 7; // lunes = 0
      const days = new Date(y, mo, 0).getDate();
      let html = T.weekdays.map((w: string) => `<span class="cal__wd">${w}</span>`).join('');
      html += '<span></span>'.repeat(offset);
      let any = false;
      for (let d = 1; d <= days; d++) {
        const date = new Date(y, mo - 1, d), id = iso(date);
        if (isOpen(date)) {
          any = true;
          const sel = selected?.date === id;
          html += `<button type="button" class="cal__day cal__day--open${sel ? ' cal__day--sel' : ''}" data-date="${id}" aria-pressed="${sel}" aria-label="${longDate(id)}">${d}</button>`;
        } else {
          html += `<span class="cal__day">${d}</span>`;
        }
      }
      grid.innerHTML = html;
      msg.textContent = any ? '' : T.noDates;
      update();
    }

    function update() {
      const total = pax.adults + pax.children;
      root!.querySelectorAll<HTMLOutputElement>('[data-out]').forEach((o) => (o.textContent = String(pax[o.dataset.out as 'adults'])));
      root!.querySelectorAll<HTMLButtonElement>('[data-inc]').forEach((b) => (b.disabled = total >= MAX_PAX));
      root!.querySelector<HTMLButtonElement>('[data-dec="adults"]')!.disabled = pax.adults <= 1;
      root!.querySelector<HTMLButtonElement>('[data-dec="children"]')!.disabled = pax.children <= 0;
      if (!selected) { summary.hidden = true; submit.disabled = true; label.textContent = T.selectDate; return; }
      const sum = pax.adults * T.priceAdult + pax.children * T.priceChild;
      summary.innerHTML =
        `<div><span>${T.dateLabel}</span><span>${longDate(selected.date)}</span></div>` +
        `<div><span>${pax.adults} × ${T.adults}</span><span>${money.format(pax.adults * T.priceAdult)}</span></div>` +
        (pax.children ? `<div><span>${pax.children} × ${T.children}</span><span>${money.format(pax.children * T.priceChild)}</span></div>` : '') +
        `<div class="total"><span>${T.total}</span><span>${money.format(sum)}</span></div>`;
      summary.hidden = false;
      submit.disabled = false;
      label.textContent = `${T.pay} ${money.format(sum)}`;
    }

    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-date]');
      if (!b) return;
      selected = { date: b.dataset.date! };
      sentBox.hidden = true;
      render();
    });
    prevBtn.addEventListener('click', () => { month = addMonth(month, -1); render(); });
    nextBtn.addEventListener('click', () => { month = addMonth(month, 1); render(); });
    root.querySelectorAll<HTMLButtonElement>('[data-inc]').forEach((b) => b.addEventListener('click', () => { pax[b.dataset.inc as 'adults']++; update(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-dec]').forEach((b) => b.addEventListener('click', () => { pax[b.dataset.dec as 'adults']--; update(); }));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!selected) return;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const fd = new FormData(form);
      if (String(fd.get('website') || '')) return; // honeypot: bots
      const M = T.msg, val = (k: string) => String(fd.get(k) || '').trim();
      const sum = pax.adults * T.priceAdult + pax.children * T.priceChild;
      const lines = [
        M.intro, '',
        `${M.date}: ${longDate(selected.date)}`,
        `${M.adults}: ${pax.adults}`,
        pax.children ? `${M.children}: ${pax.children}` : null,
        `${M.total}: ${money.format(sum)}`,
        fd.get('transport') ? M.transport : null, '',
        `${M.name}: ${val('name')}`,
        `${M.phone}: ${val('phone')}`,
        val('email') ? `${M.email}: ${val('email')}` : null,
        val('country') ? `${M.country}: ${val('country')}` : null,
        val('lodging') ? `${M.lodging}: ${val('lodging')}` : null,
        val('notes') ? `${M.notes}: ${val('notes')}` : null,
      ].filter((l) => l !== null);
      const url = `https://wa.me/${T.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      // Sin 'noopener' en las features: con él window.open siempre devuelve null y no se puede detectar el bloqueo
      const win = window.open(url, '_blank');
      if (!win) { window.location.href = url; return; } // ventana bloqueada: abre en la misma pestaña
      win.opener = null;
      sentBox.innerHTML = `${T.sent} <a href="${url}" target="_blank" rel="noopener">${T.sentRetry}</a>`;
      sentBox.hidden = false;
    });

    render();
  }
</script>
