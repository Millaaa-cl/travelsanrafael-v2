---
/**
 * Secciones reutilizables (home y ficha del tour). Uso: <Sections lang="es" show={['answer','itinerary',...]} />
 * Cada sección tiene una interacción propia y con sentido (no el mismo fade en todas):
 *  answer: collage que "emerge" como agua; itinerary: ruta que se dibuja con el scroll;
 *  includes: checks que se marcan; gallery: lightbox; parallax: foto con profundidad;
 *  reviews: carrusel arrastrable; faq: apertura animada; cta: olas.
 */
import Icon from './Icon.astro';
import Waves from './Waves.astro';
import BookingWidget from './BookingWidget.astro';
import { content } from '../i18n/content';
import { kayakContent } from '../i18n/kayak';
import { routes, pick, type Lang } from '../i18n/routes';
import { images, business, kayakImages } from '../data/tour';

type Block = 'trust' | 'answer' | 'itinerary' | 'includes' | 'gallery' | 'parallax' | 'boat' | 'reviews' | 'faq' | 'map' | 'cta';
// withBooking: muestra el widget de reserva junto al bloque "answer" (lo usa la home; la ficha del tour tiene su propio layout)
interface Props { lang: Lang; show: Block[]; withBooking?: boolean }
const { lang, show, withBooking = false } = Astro.props;
const t = content[lang];
const kp = kayakContent[lang].promoHome;
const tx = pick(lang);
const has = (b: Block) => show.includes(b);
// Fondos alternos automáticos según el orden de las secciones visibles.
const flow = show.filter((b) => !['trust', 'cta', 'parallax'].includes(b));
const bg = (b: Block) => (flow.indexOf(b) % 2 === 1 ? 'section section--ice' : 'section');
const mapQ = encodeURIComponent(`${business.address.street}, ${business.address.locality}, Aysén, Chile`);
---
{has('trust') && (
  <div class="container">
    <ul class="highlights trust" data-stagger style="margin:24px 0 0">
      {t.trust.map((i) => <li data-reveal="up"><span class="ico"><Icon name={i.icon} /></span><div><strong>{i.t}</strong><span>{i.d}</span></div></li>)}
    </ul>
  </div>
)}

{has('answer') && (
  <section class={bg('answer')} aria-labelledby="que-es">
    <div class:list={['container overview', { 'overview--booking': withBooking }]}>
      <div class="overview__text">
        <h2 id="que-es" data-reveal="up">{t.answer.h}</h2>
        <p class="answer-box" data-reveal="up">{t.answer.p}</p>
        {!withBooking && <a class="btn btn--primary" href={`${routes.tour[lang]}#reservar`} data-reveal="up">{t.bookNow}</a>}
      </div>
      {withBooking && <BookingWidget lang={lang} />}
      <div class="collage" data-stagger>
        {images.collage.map((c) => <figure data-reveal="rise"><img src={c.src} alt={c[lang]} width={c.w} height={c.h} loading="lazy" decoding="async" /></figure>)}
      </div>
      {withBooking && (
        <a class="kayak-promo" href={routes.kayak[lang]} data-reveal="up">
          <img class="kayak-promo__art" src={kayakImages.gallery[0].src} alt="" width="160" height="90" loading="lazy" decoding="async" />
          <span class="kayak-promo__body">
            <strong class="kayak-promo__h">{kp.h}</strong>
            <span class="kayak-promo__p">{kp.p}</span>
            <span class="kayak-promo__foot"><b>{kp.price}</b><span class="kayak-promo__link">{kp.link}</span></span>
          </span>
        </a>
      )}
    </div>
  </section>
)}

{has('itinerary') && (
  <section class={bg('itinerary')} id="itinerario" aria-labelledby="h-itinerario">
    <div class="container">
      <div class="section-head">
        <h2 id="h-itinerario">{t.itinerary.h}</h2>
        <p class="lead">{t.itinerary.intro}</p>
      </div>
      <ol class="route">
        {t.itinerary.steps.map((s, i) => {
          const im = images.steps[i];
          return (
            <li>
              <time>{s.time}</time>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                {im && <figure data-reveal="rise"><img src={im.src} alt={im[lang]} width={im.w} height={im.h} loading="lazy" decoding="async" style={im.pos ? `object-position:${im.pos}` : undefined} /></figure>}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
)}

{has('includes') && (
  <section class={bg('includes')} aria-labelledby="h-incluye">
    <div class="container includes-wrap">
      <div>
        <div class="section-head"><h2 id="h-incluye">{t.includes.h}</h2></div>
        <div class="includes">
          <div class="includes__card" data-checks>
            <h3>{t.includes.yesH}</h3>
            <ul>{t.includes.yes.map((x) => <li><Icon name="check" class="ok" />{x}</li>)}</ul>
          </div>
          <div class="includes__card">
            <h3>{t.includes.noH}</h3>
            <ul>{t.includes.no.map((x) => <li><Icon name="x" class="no" />{x}</li>)}</ul>
          </div>
        </div>
      </div>
      <figure class="includes-photo" data-reveal="rise"><img src={images.includes.src} alt={images.includes[lang]} width={images.includes.w} height={images.includes.h} loading="lazy" decoding="async" /></figure>
    </div>
  </section>
)}

{has('parallax') && (
  <div class="parallax" data-parallax>
    <img src={images.parallax.src} alt="" width={images.parallax.w} height={images.parallax.h} loading="lazy" decoding="async" />
    <blockquote data-reveal="up">{tx('Una hora frente a un muro de hielo milenario', 'One hour facing a wall of ancient ice', 'Une heure face à un mur de glace millénaire', 'Uma hora diante de um muro de gelo milenar')}</blockquote>
  </div>
)}

{has('gallery') && (
  <section class={bg('gallery')} aria-labelledby="h-galeria">
    <div class="container">
      <div class="section-head">
        <h2 id="h-galeria">{t.gallery.h}</h2>
        <p class="lead">{tx('Fotos reales de nuestras salidas. Toca una para verla en grande.', 'Real photos from our trips. Tap one to see it full size.', 'De vraies photos de nos sorties. Touchez-en une pour l’agrandir.', 'Fotos reais das nossas saídas. Toque em uma para ampliar.')}</p>
      </div>
      <div class="gallery" data-stagger>
        {images.gallery.map((g) => (
          <figure data-reveal="rise">
            <button type="button" data-lightbox={g.src} data-alt={g[lang]} aria-label={tx('Ampliar: ', 'Enlarge: ', 'Agrandir : ', 'Ampliar: ') + g[lang]}>
              <img src={g.src} alt={g[lang]} width={g.w} height={g.h} loading="lazy" decoding="async" style={g.pos ? `object-position:${g.pos}` : undefined} />
            </button>
            <figcaption>{g[lang]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

{has('boat') && (
  <section class={bg('boat')} aria-labelledby="h-lancha">
    <div class="container split">
      <div class="duo">
        <img src={images.boat.src} alt={images.boat[lang]} width={images.boat.w} height={images.boat.h} loading="lazy" decoding="async" data-reveal="rise" />
        <img src={images.boatShore.src} alt={images.boatShore[lang]} width={images.boatShore.w} height={images.boatShore.h} loading="lazy" decoding="async" data-reveal="rise" style="--i:2" />
      </div>
      <div>
        <h2 id="h-lancha" data-reveal="up">{t.boat.h}</h2>
        <p data-reveal="up">{t.boat.p}</p>
      </div>
    </div>
  </section>
)}

{has('reviews') && (
  <section class={bg('reviews')} aria-labelledby="h-resenas">
    <div class="container reviews-wrap">
      <figure class="reviews-photo" data-reveal="rise"><img src={images.reviews.src} alt={images.reviews[lang]} width={images.reviews.w} height={images.reviews.h} loading="lazy" decoding="async" /></figure>
      <div>
        <div class="section-head"><h2 id="h-resenas">{t.reviews.h}</h2></div>
        <div class="reviews" data-carousel tabindex="0" aria-label={t.reviews.h}>
          {t.reviews.items.map((r) => (
            <figure class="review">
              <div class="stars" aria-label="5/5">★★★★★</div>
              <blockquote>“{r.text}”</blockquote>
              <figcaption>{r.name}</figcaption>
            </figure>
          ))}
        </div>
        <div class="carousel-nav">
          <button type="button" data-prev aria-label={tx('Reseña anterior', 'Previous review', 'Avis précédent', 'Avaliação anterior')}>‹</button>
          <button type="button" data-next aria-label={tx('Reseña siguiente', 'Next review', 'Avis suivant', 'Próxima avaliação')}>›</button>
        </div>
      </div>
    </div>
  </section>
)}

{has('faq') && (
  <section class={bg('faq')} aria-labelledby="h-faq">
    <div class="container faq-split">
      <div>
        <h2 id="h-faq">{t.faqH}</h2>
        <p class="lead" style="font-size:1.05rem">{tx('¿No encuentras tu respuesta?', 'Can’t find your answer?', 'Vous ne trouvez pas votre réponse ?', 'Não encontrou sua resposta?')} <a href={routes.contact[lang]}>{tx('Escríbenos', 'Contact us', 'Écrivez-nous', 'Fale conosco')}</a>.</p>
        <figure class="faq-photo" data-reveal="rise"><img src={images.faq.src} alt={images.faq[lang]} width={images.faq.w} height={images.faq.h} loading="lazy" decoding="async" /></figure>
      </div>
      <div class="faq">
        {t.faq.map((f, i) => (
          <details open={i === 0}><summary>{f.q}</summary><div class="faq__body"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>
)}

{has('map') && (
  <section class={bg('map')} aria-labelledby="h-mapa">
    <div class="container split">
      <div>
        <h2 id="h-mapa" data-reveal="up">{t.map.h}</h2>
        <p data-reveal="up">{t.map.p}</p>
        <p data-reveal="up"><a href={routes.howTo[lang]}>{tx('Cómo llegar a Puerto Río Tranquilo', 'How to get to Puerto Río Tranquilo', 'Comment venir à Puerto Río Tranquilo', 'Como chegar a Puerto Río Tranquilo')}</a></p>
        <figure class="map-photo" data-reveal="rise"><img src={images.map.src} alt={images.map[lang]} width={images.map.w} height={images.map.h} loading="lazy" decoding="async" /></figure>
      </div>
      <iframe class="map-embed" title={t.map.h} src={`https://www.google.com/maps?q=${mapQ}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" data-reveal="up"></iframe>
    </div>
  </section>
)}

{has('cta') && (
  <section class="cta-photo">
    <img src={images.cta.src} alt="" width={images.cta.w} height={images.cta.h} loading="lazy" decoding="async" />
    <div class="container">
      <h2 data-reveal="up">{t.cta.h}</h2>
      <p data-reveal="up">{t.cta.p}</p>
      <a class="btn btn--primary" href={`${routes.tour[lang]}#reservar`} data-reveal="up">{t.bookNow}</a>
    </div>
    <Waves to="ink" />
  </section>
)}
