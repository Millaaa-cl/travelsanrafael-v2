---
import Icon from './Icon.astro';
import { routes, type Lang } from '../i18n/routes';
import { content } from '../i18n/content';
import { tour, formatCLP, waLink } from '../data/tour';

interface Props { lang: Lang; mobileCta?: boolean }
const { lang, mobileCta = true } = Astro.props;
const t = content[lang];
---
<a class="wa-fab" href={waLink(t.whatsappMsg)} target="_blank" rel="noopener" aria-label={t.whatsappLabel}>
  <Icon name="whatsapp" />
</a>
{mobileCta && (
  <div class="mobile-cta">
    <div>
      <small>{lang === 'es' ? 'Adulto, sin transporte' : 'Adult, no transport'}</small>
      <strong>{formatCLP(tour.priceFromCLP)}</strong>
    </div>
    <a class="btn btn--primary" href={`${routes.tour[lang]}#reservar`}>{t.bookNow}</a>
  </div>
)}
