---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { routes, langs, locales, pick, type Lang, type RouteKey } from '../i18n/routes';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/tour';

interface Props {
  lang: Lang;
  title: string;          // 50–60 caracteres, con la palabra clave al inicio
  description: string;    // 140–160 caracteres
  routeKey?: RouteKey;    // para hreflang y el selector de idioma
  alternates?: Record<Lang, string>;
  image?: string;
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  mobileCta?: boolean;
}

const { lang, title, description, routeKey, alternates: alt, image = '/images/og-laguna-san-rafael.jpg', schema = [], noindex = false, ogType = 'website', mobileCta = true } = Astro.props;
const site = Astro.site ?? new URL(business.url);
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = alt ?? (routeKey ? routes[routeKey] : undefined);
const ogImage = new URL(image, site).href;
// La marca se agrega solo si cabe: Google corta los títulos de más de unos 60 caracteres.
const fullTitle = title.includes(business.name) || title.length > 42 ? title : `${title} | ${business.name}`;
const jsonLd = [organizationSchema(), websiteSchema(lang), ...schema];
const tx = pick(lang);
// Google Tag Manager: snippet oficial (empuja el evento gtm.js que usan los activadores "Todas las páginas")
const gtm = business.gtmId;
const gtmHead = gtm && `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtm}');`;
---
<!doctype html>
<html lang={locales[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gtm && <script is:inline set:html={gtmHead} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates && !noindex && (
      <>
        {langs.map((l) => <link rel="alternate" hreflang={locales[l].html} href={new URL(alternates[l], site).href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, site).href} />
      </>
    )}
    <meta name="theme-color" content="#0b2a3c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang].og} />
    {alternates && langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Geo meta (SEO local) -->
    <meta name="geo.region" content="CL-AI" />
    <meta name="geo.placename" content={business.address.locality} />
    <meta name="geo.position" content={`${business.geo.lat};${business.geo.lng}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet" />

    <!-- Activa los estados iniciales de animación; si motion.ts no carga en 2,5 s, se muestra todo -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__motion)document.documentElement.classList.add('no-motion')},2500);</script>

    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <div class="progress" aria-hidden="true"></div>
    <Header lang={lang} alternates={alternates} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} mobileCta={mobileCta} service={routeKey === 'kayak' ? 'kayak' : 'tour'} />
    <dialog class="lightbox" aria-label={tx('Galería ampliada', 'Enlarged gallery', 'Galerie agrandie', 'Galeria ampliada')}>
      <figure><img src="data:," alt="" /><figcaption></figcaption></figure>
      <button type="button" class="lightbox__btn lightbox__prev" aria-label={tx('Foto anterior', 'Previous photo', 'Photo précédente', 'Foto anterior')}>‹</button>
      <button type="button" class="lightbox__btn lightbox__next" aria-label={tx('Foto siguiente', 'Next photo', 'Photo suivante', 'Próxima foto')}>›</button>
      <button type="button" class="lightbox__btn lightbox__close" aria-label={tx('Cerrar', 'Close', 'Fermer', 'Fechar')}>×</button>
    </dialog>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
