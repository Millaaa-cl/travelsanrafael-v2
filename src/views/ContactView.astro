---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { content } from '../i18n/content';
import { routes, pick, type Lang } from '../i18n/routes';
import { business, waLink } from '../data/tour';
import { breadcrumbSchema } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const tx = pick(lang);
const crumbs = [{ name: tx('Inicio', 'Home', 'Accueil', 'Início'), path: routes.home[lang] }, { name: t.nav.contact, path: routes.contact[lang] }];
const mapQ = encodeURIComponent(`${business.address.street}, ${business.address.locality}, Aysén, Chile`);
const office = `${business.address.street}, ${business.address.locality}`;
const seo = tx(
  { title: 'Contacto Costa Carrera Travel, Puerto Río Tranquilo', description: `Contáctanos por WhatsApp, teléfono o correo para el tour a la Laguna San Rafael. Oficina en ${office}. Atención de lunes a domingo.` },
  { title: 'Contact Costa Carrera Travel, Puerto Río Tranquilo', description: `Contact us by WhatsApp, phone or email about the San Rafael Lagoon tour. Office at ${office}. Open every day.` },
  { title: 'Contact Costa Carrera Travel, Puerto Río Tranquilo', description: `Contactez-nous par WhatsApp, téléphone ou e-mail pour l’excursion à la lagune San Rafael. Bureau au ${office}. Ouvert tous les jours.` },
  { title: 'Contato Costa Carrera Travel, Puerto Río Tranquilo', description: `Fale conosco pelo WhatsApp, telefone ou e-mail sobre o passeio à Laguna San Rafael. Escritório na ${office}. Atendimento todos os dias.` },
);
---
<Base lang={lang} title={seo.title} description={seo.description} routeKey="contact" schema={[breadcrumbSchema(crumbs)]}>
  <PageHero title={t.nav.contact} kicker="Costa Carrera Travel" lead={tx('Respondemos rápido por WhatsApp. Si prefieres, llámanos o escríbenos un correo.', 'We reply fast on WhatsApp. You can also call or email us.', 'Nous répondons vite sur WhatsApp. Vous pouvez aussi nous appeler ou nous écrire un e-mail.', 'Respondemos rápido pelo WhatsApp. Se preferir, ligue ou envie um e-mail.')} crumbs={crumbs} />
  <section class="section">
    <div class="container split">
      <div>
        <ul class="contact-list">
          <li><span class="ico"><Icon name="pin" /></span><span>{business.address.street}, {business.address.locality}, {business.address.region}, Chile</span></li>
          {business.phones.map((p, i) => <li><span class="ico"><Icon name="phone" /></span><a href={`tel:${p}`}>{business.phoneDisplay[i]}</a></li>)}
          <li><span class="ico"><Icon name="mail" /></span><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li><span class="ico"><Icon name="clock" /></span><span>{t.footer.hours}</span></li>
        </ul>
        <div class="contact-actions">
          <a class="btn btn--primary" href={waLink(t.whatsappMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
          <a class="btn btn--ghost" style="color:var(--ink)" href={`${routes.tour[lang]}#reservar`}>{t.bookNow}</a>
        </div>
      </div>
      <iframe class="map-embed" title={tx('Mapa de la oficina', 'Office map', 'Carte du bureau', 'Mapa do escritório')} src={`https://www.google.com/maps?q=${mapQ}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
